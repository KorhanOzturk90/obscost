prometheus.remote_write "tenant_payments" {
  endpoint {
    url     = "http://mimir-gateway.mimir.svc/api/v1/push"
    headers = {"X-Scope-OrgID" = "payments"}
  }
}

discovery.relabel "tenant_platform" {
  targets = discovery.relabel.tenant_pods.output
  rule {
    source_labels = ["__tenant__"]
    regex         = "platform"
    action        = "keep"
  }
}
prometheus.scrape "tenant_platform" {
  targets         = discovery.relabel.tenant_platform.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.tenant_platform.receiver]
}
prometheus.remote_write "tenant_platform" {
  endpoint {
    url     = "http://mimir-gateway.mimir.svc/api/v1/push"
    headers = {"X-Scope-OrgID" = "platform"}
  }
}
