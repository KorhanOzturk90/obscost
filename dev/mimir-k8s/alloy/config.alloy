  targets         = discovery.relabel.tenant_infra.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.tenant_infra.receiver]
}
prometheus.remote_write "tenant_infra" {
  endpoint {
    url     = "http://mimir-gateway.mimir.svc/api/v1/push"
    headers = {"X-Scope-OrgID" = "infra"}
  }
}

discovery.relabel "tenant_payments" {
  targets = discovery.relabel.tenant_pods.output
  rule {
    source_labels = ["__tenant__"]
    regex         = "payments"
